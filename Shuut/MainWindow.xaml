        <TextBlock x:Name="t4" HorizontalAlignment="Left" Margin="249,287,0,0" Text="TextBlock" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <Button Content="send" HorizontalAlignment="Left" Margin="400,297,0,0" VerticalAlignment="Top" Click="Button_Click_1"/>
        <Button Content="get" HorizontalAlignment="Left" Margin="415,353,0,0" VerticalAlignment="Top" Click="Button_Click_2"/>
