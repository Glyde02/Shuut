<Window x:Class="Shuut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shuut"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="Window">
        <Button x:Name="btnPlay" Content="Play" HorizontalAlignment="Left" Margin="531,162,0,0" VerticalAlignment="Top" Click="Button_Click" IsEnabled="False"/>
        <Button x:Name="btnGenerateMap" Content="Generate" HorizontalAlignment="Left" Margin="478,254,0,0" VerticalAlignment="Top" Click="btnGenerateMap_Click" Width="93"/>
        <Button x:Name="btnLoadMap" Content="Load map" HorizontalAlignment="Left" Margin="478,287,0,0" VerticalAlignment="Top" Width="93" Click="btnLoadMap_Click"/>
        <Button x:Name="btnServer" Content="Server" HorizontalAlignment="Left" Margin="70,167,0,0" VerticalAlignment="Top" Click="btnServer_Click"/>
        <Button x:Name="btnClient" Content="Client" HorizontalAlignment="Left" Margin="70,202,0,0" VerticalAlignment="Top" Click="btnClient_Click" Width="37"/>
        <CheckBox x:Name="checkSingle" Content="CheckBox" HorizontalAlignment="Left" Margin="201,111,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
